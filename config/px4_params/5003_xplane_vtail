#!/bin/sh
################################################################################
# PX4 SITL Configuration Script for Generic V-Tail Fixed-Wing in X-Plane
################################################################################
#
# @name              VTail Fixed Wing Aircraft
# @type              Plane V-Tail
# @class             Plane
# @maintainer        alireza787b <p30planets@gmail.com>
# @url               https://github.com/alireza787b/px4xplane/
#
# Aircraft:          Generic V-Tail Fixed-Wing (Mini Talon / similar)
# Type:              Fixed-Wing (V-Tail, no flaps)
# Configuration:     1 Propeller Motor + 4 Control Surfaces (ailerons + V-tail)
# Compatible Sim:    X-Plane 11/12
#
# AIRCRAFT SPECIFICATIONS:
# - MTOW: ~5 kg - Small electric UAV
# - Wingspan: ~1.3 m
# - Cruise Speed: 20 m/s (39 kts)
# - Stall Speed: 12 m/s (23 kts)
# - Engine: Electric brushless motor
# - Sensors: Barometer, GPS, Magnetometer, Airspeed
#
# CHANNEL MAPPING (matches config.ini [VTail] section):
# ch0 (PWM_MAIN_FUNC1): Left Aileron
# ch1 (PWM_MAIN_FUNC2): Right Aileron
# ch2 (PWM_MAIN_FUNC3): Left V-tail  (pitch + yaw mixing)
# ch3 (PWM_MAIN_FUNC4): Right V-tail (pitch + yaw mixing)
# ch4 (PWM_MAIN_FUNC5): Propeller (Motor 1)
#
# USAGE:
# 1. Place this file in: PX4-Autopilot/ROMFS/px4fmu_common/init.d-posix/airframes/
# 2. Run: make px4_sitl xplane_vtail
# 3. Launch X-Plane with a V-tail aircraft model
# 4. Set config_name = VTail in px4xplane config.ini
#
################################################################################

. ${R}etc/init.d/rc.fw_defaults


################################################################################
# SECTION 1: CONTROL ALLOCATION (CA) - V-TAIL CONFIGURATION
################################################################################
# Motor: Front/rear propeller (+1.0m from CG, thrust forward)
# Control Surfaces: Left/Right Ailerons, Left/Right V-tail ruddervators
#
# V-TAIL MIXING:
# - Both surfaces move UP together   → pitch UP
# - Both surfaces move DOWN together → pitch DOWN
# - Left UP  + Right DOWN            → yaw RIGHT
# - Left DOWN + Right UP             → yaw LEFT
#
# Left V-tail  deflection = (pitch_cmd × 0.5) + (yaw_cmd × -0.5)
# Right V-tail deflection = (pitch_cmd × 0.5) + (yaw_cmd ×  0.5)

param set-default CA_AIRFRAME 1          # Fixed-wing configuration
param set-default CA_METHOD 2            # Pseudo-inverse allocation
param set-default CA_FAILURE_MODE 0
param set-default CA_ROTOR_COUNT 1       # 1 propeller motor

# Propeller Motor 0
param set-default CA_ROTOR0_PX 1.0       # 1.0m forward of CG
param set-default CA_ROTOR0_AX 1.0       # Thrust forward
param set-default CA_ROTOR0_AZ 0.0
param set-default CA_R0_SLEW 2.0         # Smooth throttle changes

# Control Surfaces
param set-default CA_SV_CS0_TRQ_R -0.5  # Left Aileron
param set-default CA_SV_CS0_TYPE 1
param set-default CA_SV_CS1_TRQ_R 0.5   # Right Aileron
param set-default CA_SV_CS1_TYPE 2
param set-default CA_SV_CS2_TRQ_P 0.8   # Left V-tail (pitch + yaw)
param set-default CA_SV_CS2_TRQ_Y -0.8
param set-default CA_SV_CS2_TYPE 13     # Type 13 = Left V-tail ruddervator
param set-default CA_SV_CS3_TRQ_P 0.8   # Right V-tail (pitch + yaw)
param set-default CA_SV_CS3_TRQ_Y 0.8
param set-default CA_SV_CS3_TYPE 14     # Type 14 = Right V-tail ruddervator
param set-default CA_SV_CS_COUNT 4

# PWM Output Mapping (matches config.ini [VTail] channel order)
param set-default PWM_MAIN_FUNC1 201     # Left aileron  → ch0
param set-default PWM_MAIN_FUNC2 202     # Right aileron → ch1
param set-default PWM_MAIN_FUNC3 203     # Left V-tail   → ch2
param set-default PWM_MAIN_FUNC4 204     # Right V-tail  → ch3
param set-default PWM_MAIN_FUNC5 101     # Propeller     → ch4


################################################################################
# SECTION 2: EKF2 SENSOR FUSION - OPTIMIZED FOR X-PLANE SITL
################################################################################
# Applied optimizations:
# - Barometer: 0.003 (3mm noise) for stable altitude hold
# - Single sensor priority prevents BARO switch errors
# - Innovation gates: 5.0–10.0 for FPS-independent robustness

# Sensor Simulation Enables
param set-default SENS_EN_GPSSIM 1       # GPS simulation
param set-default SENS_EN_BAROSIM 1      # Barometer simulation
param set-default SENS_EN_ARSPDSIM 1     # Airspeed simulation
param set-default SENS_EN_MAGSIM 1       # Magnetometer simulation
param set-default SYS_HAS_BARO 1
param set-default SYS_HAS_GPS 1
param set-default SYS_HAS_MAG 1

# Barometer Priority (prevents mid-flight sensor switching)
param set-default CAL_BARO0_PRIO 100     # Primary barometer
param set-default CAL_BARO1_PRIO 0       # Backup disabled

# EKF2 Core Configuration
param set-default EKF2_BARO_CTRL 1
param set-default EKF2_MULTI_IMU 1

# Accelerometer Bias Estimation
# Small vtail UAV in X-Plane has more jitter than Cessna/TB2 — bias limit must
# be wider. EKF2_ABL_LIM=4.0 prevents the "High Accelerometer Bias" preflight
# fail without affecting flight performance (only the arming check threshold).
param set-default EKF2_ABIAS_INIT 0.3    # Wider initial estimate for small UAV
param set-default EKF2_ABL_LIM 9.0       # X-Plane vtail bias can reach ~8m/s²; check threshold = 0.9×limit
param set-default EKF2_ABL_TAU 0.8       # Slower adaptation — avoids chasing noise
param set-default EKF2_ABL_ACCLIM 35.0
param set-default EKF2_ACC_NOISE 1.5     # Trust accel less — small airframe oscillates more
param set-default EKF2_ACC_B_NOISE 0.003 # Higher process noise matches small-UAV dynamics

# Gyroscope Noise
param set-default EKF2_GYR_NOISE 0.02    # Slightly relaxed for small-UAV vibration
param set-default EKF2_GYR_B_NOISE 0.001 # Gyro bias process noise (rad/s)

# Barometer — loosened to fix "height estimate not stable" / "vertical velocity unstable"
# Small UAV aerodynamics cause larger baro fluctuations than a Cessna; tighter
# gate (0.003/10.0) causes the innovation to be rejected → unstable height estimate.
param set-default EKF2_BARO_NOISE 0.02   # 20mm — matches small-UAV baro fluctuations
param set-default EKF2_BARO_DELAY 0.0
param set-default EKF2_BARO_GATE 15.0    # Wider gate prevents height estimate rejection

# GPS Parameters
param set-default EKF2_GPS_DELAY 0.0
param set-default EKF2_GPS_P_NOISE 0.2   # Slightly relaxed for small-UAV GPS antenna
param set-default EKF2_GPS_V_NOISE 0.3   # Higher vertical velocity noise — small UAV bounces more
param set-default EKF2_GPS_P_GATE 5.0
param set-default EKF2_GPS_V_GATE 7.0    # Wider gate — 3.0 was too tight and caused vertical velocity instability

# Magnetometer
param set-default EKF2_MAG_TYPE 0
param set-default EKF2_HEAD_NOISE 0.3
param set-default EKF2_MAG_NOISE 0.05
param set-default EKF2_MAG_GATE 5.0

# Airspeed & Additional Sensors
param set-default EKF2_ASP_DELAY 0.0
param set-default EKF2_TAS_GATE 5.0
param set-default EKF2_AGP_CTRL 3
param set-default EKF2_AVEL_DELAY 0.0
param set-default EKF2_WIND_NSD 0.01
param set-default EKF2_REQ_VDRIFT 1.0

# IMU Configuration
param set-default IMU_GYRO_RATEMAX 100
param set-default IMU_INTEG_RATE 100


################################################################################
# SECTION 3: FIXED-WING RATE CONTROL - PID TUNING
################################################################################
# Tuned for small V-tail UAV (~5 kg, 1.3 m wingspan).
# Faster roll/pitch rates than Cessna due to smaller inertia.

# Roll Rate
param set-default FW_RR_P 0.15           # P gain (light airframe)
param set-default FW_RR_I 0.10           # I gain
param set-default FW_RR_D 0.01           # D gain
param set-default FW_RR_FF 0.6           # Feedforward
param set-default FW_R_RMAX 30.0         # Max roll rate (deg/s) - agile UAV
param set-default FW_R_TC 0.4            # Time constant
param set-default FW_R_LIM 50.0          # Roll angle limit

# Pitch Rate
param set-default FW_PR_P 0.12           # P gain
param set-default FW_PR_I 0.08           # I gain
param set-default FW_PR_D 0.01           # D gain
param set-default FW_PR_FF 0.5           # Feedforward
param set-default FW_P_LIM_MAX 25.0      # Max pitch up
param set-default FW_P_LIM_MIN -20.0     # Max pitch down
param set-default FW_P_TC 0.4
param set-default FW_PN_R_SLEW_MAX 50.0

# Yaw Rate (V-tail provides yaw via mixing; direct yaw gains shape response)
param set-default FW_YR_P 0.08
param set-default FW_YR_I 0.05
param set-default FW_YR_D 0.003
param set-default FW_YR_FF 0.3


################################################################################
# SECTION 4: AIRSPEED CONTROL
################################################################################
# Flight envelope: Stall 12 m/s, Cruise 20 m/s, Max 35 m/s

param set-default FW_AIRSPD_MIN 15.0     # Min airspeed (3 m/s above stall)
param set-default FW_AIRSPD_MAX 35.0     # Max airspeed
param set-default FW_AIRSPD_TRIM 20.0    # Efficient cruise
param set-default FW_AIRSPD_STALL 12.0   # Stall speed

# Airspeed Sensor (SITL)
param set-default FW_USE_AIRSPD 1        # Use airspeed for control
param set-default ASPD_DO_CHECKS 7       # Disable hardware checks (SITL)
param set-default SYS_HAS_NUM_ASPD 1     # 1 virtual airspeed sensor


################################################################################
# SECTION 5: TECS - TOTAL ENERGY CONTROL SYSTEM
################################################################################
# Manages coupled altitude/airspeed control.
# Small UAV: faster response, higher climb rates relative to size.

# Core Parameters
param set-default FW_T_ALT_TC 5.0        # Altitude time constant (faster than Cessna)
param set-default FW_T_RLL2THR 15.0      # Roll to throttle coupling
param set-default FW_T_STE_R_TC 1.0      # Energy rate time constant

# Climb/Sink Limits (electric motor / ~5 kg)
param set-default FW_T_CLMB_MAX 5.0      # Max climb rate (m/s)
param set-default FW_T_SINK_MIN 2.0      # Min sink
param set-default FW_T_SINK_MAX 5.0      # Max sink
param set-default FW_T_VERT_ACC 7.0      # Vertical acceleration limit

# Damping
param set-default FW_T_THR_DAMPING 0.1   # Throttle damping
param set-default FW_T_PTCH_DAMP 0.1     # Pitch damping

# Integrators
param set-default FW_T_I_GAIN_PIT 0.3    # Pitch integrator


################################################################################
# SECTION 6: THROTTLE MANAGEMENT
################################################################################
# Electric motor - instant response, no spool-up delay

param set-default FW_THR_TRIM 0.60       # 60% cruise throttle
param set-default FW_THR_MAX 1.0         # 100% max
param set-default FW_THR_MIN 0.05        # 5% min (motor keeps spinning)
param set-default FW_THR_IDLE 0.00       # Idle
param set-default FW_THR_SLEW_MAX 0.50   # Throttle slew rate
param set-default FW_THR_ASPD_MAX 0.00
param set-default FW_THR_ASPD_MIN 0.00


################################################################################
# SECTION 7: TAKEOFF & LANDING
################################################################################
# Hand-launch or rolling takeoff; belly landing (no gear)

# Takeoff
param set-default FW_TKO_AIRSPD 18.0     # Rotation/hand-launch release speed
param set-default FW_TKO_PITCH_MIN 15.0  # Min pitch angle on climb-out
param set-default MIS_TAKEOFF_ALT 30.0   # Takeoff altitude

# Landing
param set-default FW_LND_ABORT 0
param set-default FW_LND_AIRSPD 0        # Auto (based on stall speed)
param set-default FW_LND_FLALT 3.0       # Flare altitude (low - no landing gear)
param set-default FW_LND_FL_PMAX 25.0    # Max pitch during flare
param set-default LNDFW_AIRSPD_MAX 25.0
param set-default LNDFW_VEL_XY_MAX 15.0


################################################################################
# SECTION 8: NPFG GUIDANCE (Modern PX4 v1.14+)
################################################################################
# Small UAV: tighter turning radius, shorter NPFG period.
# Formula: L1_distance = (1/π) × NPFG_DAMPING × NPFG_PERIOD × groundspeed
# At 20 m/s cruise with period=20: ~143m turning radius

param set-default NPFG_PERIOD 20.0       # Short period for agile small UAV
param set-default NPFG_DAMPING 0.75      # Damping ratio
param set-default NPFG_ROLL_TC 0.4       # Roll time constant
param set-default NPFG_SW_DST_MLT 1.0    # Switch distance multiplier


################################################################################
# SECTION 9: NAVIGATION & MISSION
################################################################################
# Small UAV: tight waypoint acceptance radii for precise survey/ISR paths

# Mission Parameters
param set-default MIS_YAW_ERR 30.0
param set-default MIS_YAW_TMT 5.0
param set-default MIS_TAKEOFF_ALT 30.0
param set-default MIS_TKO_LAND_REQ 0
param set-default MIS_DIST_1WP 1000.0

# Acceptance Radii (tight for small UAV)
param set-default NAV_ACC_RAD 25.0       # Waypoint acceptance radius
param set-default NAV_FW_ALT_RAD 10.0   # Altitude acceptance
param set-default NAV_MIN_LTR_ALT -1.0

# Loiter Configuration
param set-default NAV_LOITER_RAD 100.0  # Tight loiter (20 m/s cruise)

# Return to Launch
param set-default RTL_RETURN_ALT 50     # RTL altitude
param set-default RTL_DESCEND_ALT 30
param set-default RTL_MIN_DIST 10.0
param set-default RTL_LOITER_RAD 100.0


################################################################################
# SECTION 10: ADVANCED FEATURES & SYSTEM CONFIGURATION
################################################################################

# Logging
param set-default SDLOG_MODE 0           # Disabled for SITL

# Circuit Breakers (SITL-SPECIFIC - DO NOT USE ON REAL HARDWARE)
param set-default CBRK_USB_CHK 197848    # Disable USB check
param set-default CBRK_SUPPLY_CHK 894281 # Disable battery check
param set-default CBRK_IO_SAFETY 22027   # Disable safety switch

# RC / Joystick Input Mode
# 0=RC transmitter only  1=Joystick/MAVLink RC_CHANNELS_OVERRIDE  3=No input required
# Mode 1: PX4 accepts RC_CHANNELS_OVERRIDE from GCS/script as the RC source.
# Required for test_joystick.py and QGC joystick to work in SITL.
param set-default COM_RC_IN_MODE 1
# Disable RC loss failsafe — no physical RC in SITL
param set-default NAV_RCL_ACT 0


################################################################################
# TROUBLESHOOTING GUIDE
################################################################################
#
# V-tail yaw coupling / unexpected roll when yawing:
#   - Verify CA_SV_CS2_TRQ_P=0.8, CA_SV_CS2_TRQ_Y=-0.8 (left surface)
#   - Verify CA_SV_CS3_TRQ_P=0.8, CA_SV_CS3_TRQ_Y=0.8  (right surface)
#   - If aircraft yaws opposite direction, negate both TRQ_Y values
#   - If elevator is reversed, negate both TRQ_P values
#
# Aircraft oscillates in pitch (hunting):
#   - Reduce FW_PR_P (0.12 → 0.08)
#   - Reduce FW_T_PTCH_DAMP or FW_T_THR_DAMPING slightly
#
# Aircraft rolls excessively when pitching (V-tail coupling):
#   - The V-tail inherently couples pitch and yaw — some roll coupling is normal
#   - Tune FW_RR_P and FW_YR_P together to find balance
#
# Can't arm - airspeed sensor invalid:
#   - Verify SENS_EN_ARSPDSIM = 1
#   - Check SYS_HAS_NUM_ASPD = 1
#   - Verify ASPD_DO_CHECKS = 7
#
# Wide loiter / overshoots waypoints:
#   - Reduce NPFG_PERIOD (20 → 15)
#   - Reduce NAV_LOITER_RAD (100 → 75m)
#
# BARO switch error during flight:
#   - Verify CAL_BARO1_PRIO = 0
#   - Check CAL_BARO0_PRIO = 100
#
# V-TAIL MIXING REFERENCE:
# Left V-tail  = (pitch × 0.5) + (yaw × -0.5)
# Right V-tail = (pitch × 0.5) + (yaw ×  0.5)
#
################################################################################
# END OF CONFIGURATION
################################################################################
